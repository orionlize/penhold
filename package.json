{
  "name": "penhold-mcp",
  "version": "0.1.0",
  "description": "本地 AI 设计画布：AI 通过 MCP 绘制与读取 UI 稿，用户在浏览器画布中微调，可导出单文件 HTML",
  "type": "module",
  "bin": {
    "penhold-mcp": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "guides",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p . && node -e \"require('fs').chmodSync('dist/server/cli.js',0o755)\"",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "daemon": "tsx src/cli.ts daemon",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "design",
    "canvas"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
